{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lumen Symbol Data",
  "description": "Schema for symbol view data in Lumen Circuit Studio",
  "type": "object",
  "required": ["type", "name", "library", "pins"],
  "properties": {
    "type": {
      "type": "string",
      "const": "symbol"
    },
    "name": {
      "type": "string",
      "description": "Device/cell name"
    },
    "library": {
      "type": "string",
      "description": "Library name (e.g., 'primitives' or 'pdk:sky130')"
    },
    "prefix": {
      "type": "string",
      "description": "SPICE prefix (R, C, M, Q, D, etc.)",
      "default": "X"
    },
    "spice_model": {
      "type": "string",
      "description": "SPICE model name for netlisting"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description"
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "x", "y"],
        "properties": {
          "name": {"type": "string"},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "direction": {
            "type": "string",
            "enum": ["input", "output", "inout", "power", "ground"]
          },
          "net_name": {
            "type": "string",
            "description": "Hard-coded net name (for power/ground pins)"
          }
        }
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["line", "rect", "circle", "polyline", "polygon", "arc"]
          },
          "x1": {"type": "number"},
          "y1": {"type": "number"},
          "x2": {"type": "number"},
          "y2": {"type": "number"},
          "cx": {"type": "number"},
          "cy": {"type": "number"},
          "r": {"type": "number"},
          "rx": {"type": "number"},
          "ry": {"type": "number"},
          "w": {"type": "number"},
          "h": {"type": "number"},
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {"type": "number"},
              "minItems": 2,
              "maxItems": 2
            }
          },
          "start": {"type": "number"},
          "span": {"type": "number"}
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "default": {"type": "string"},
          "description": {"type": "string"},
          "unit": {"type": "string"},
          "display_name": {"type": "string"}
        }
      }
    },
    "label": {
      "type": "object",
      "properties": {
        "text": {"type": "string"},
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    }
  }
}